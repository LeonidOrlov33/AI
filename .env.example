# OpenRouter-compatible defaults. Можно заменить на собственные шлюзы Gemini/DeepSeek/Qwen.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_MODEL=google/gemini-2.5-pro
DEEPSEEK_MODEL=deepseek/deepseek-r1-671b
QWEN_MODEL=qwen/qwen3-235b-a22b-thinking-2507

# Render deployment (optional)
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_NAME=autocoder-generated-app
RENDER_REGION=oregon
RENDER_PLAN=free
